{
  "name": "x1-games",
  "version": "0.0.0",
  "private": true,
  "description": "x1-games platform monorepo — settlement layer for wagered play on X1",
  "workspaces": [
    "apps/*",
    "apps/sample-games/*",
    "packages/*",
    "chain"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:chain": "cd chain && anchor test",
    "test:sdk": "bun test --cwd packages/games-sdk",
    "test:services": "bun test --cwd apps/services"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.6.3",
    "@types/bun": "^1.1.13"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.2.21"
}
