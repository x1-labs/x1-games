{
  "name": "@x1-labs/games-protocol",
  "version": "0.1.0",
  "description": "Canonical Zod schemas and replay-store interface for the X1 Games integration contract (INTEGRATION.md v0)",
  "license": "MIT",
  "author": "X1 Labs Team",
  "homepage": "https://github.com/x1-labs/x1-games/tree/master/packages/games-protocol#readme",
  "bugs": "https://github.com/x1-labs/x1-games/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x1-labs/x1-games.git",
    "directory": "packages/games-protocol"
  },
  "keywords": [
    "x1",
    "x1-games",
    "solana",
    "gamefi",
    "schemas",
    "zod",
    "protocol"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --external zod && tsc -b",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo tsconfig.tsbuildinfo LICENSE",
    "prepublishOnly": "bun run clean && bun run build && cp ../../LICENSE ./LICENSE"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.13",
    "typescript": "^5.6.3"
  }
}
