{
  "name": "@x1-labs/games-sdk",
  "version": "0.1.3",
  "description": "Typed TypeScript SDK for building games on X1 Games — match lifecycle, settlement, replays, XP",
  "license": "MIT",
  "author": "X1 Labs Team",
  "homepage": "https://github.com/x1-labs/x1-games/tree/master/packages/games-sdk#readme",
  "bugs": "https://github.com/x1-labs/x1-games/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x1-labs/x1-games.git",
    "directory": "packages/games-sdk"
  },
  "keywords": [
    "x1",
    "x1-games",
    "solana",
    "anchor",
    "gamefi",
    "sdk",
    "wallet-adapter"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --external @coral-xyz/anchor --external @solana/web3.js --external @x1-labs/games-protocol --external zod --external tweetnacl --external bs58 && tsc -b --force",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo tsconfig.tsbuildinfo LICENSE",
    "prepublishOnly": "bun run clean && bun run build && cp ../../LICENSE ./LICENSE"
  },
  "peerDependencies": {
    "@coral-xyz/anchor": "^0.32.0",
    "@solana/web3.js": "^1.95.0"
  },
  "dependencies": {
    "@x1-labs/games-protocol": "^0.1.1",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^1.95.4",
    "@types/bun": "^1.1.13",
    "typescript": "^5.6.3"
  }
}
